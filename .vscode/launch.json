{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Path Navigator",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/path-navigator"
      ],
      "outFiles": [
        "${workspaceFolder}/extensions/path-navigator/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
