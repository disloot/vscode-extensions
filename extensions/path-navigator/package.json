{
  "name": "path-navigator",
  "displayName": "Path Navigator",
  "description": "Quickly open files or reveal directories by searching their workspace-relative paths.",
  "version": "0.4.0",
  "publisher": "Disloot",
  "icon": "resources/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/disloot/vscode-extensions.git",
    "directory": "extensions/path-navigator"
  },
  "homepage": "https://github.com/disloot/vscode-extensions/tree/main/extensions/path-navigator",
  "bugs": {
    "url": "https://github.com/disloot/vscode-extensions/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "path",
    "file",
    "folder",
    "quick open",
    "navigation"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "pathNavigator.open",
        "title": "Open File or Reveal Directory",
        "category": "Path Navigator"
      },
      {
        "command": "pathNavigator.refreshIndex",
        "title": "Refresh Path Index",
        "category": "Path Navigator",
        "icon": "$(refresh)"
      },
      {
        "command": "pathNavigator.completePath",
        "title": "Complete Selected Path",
        "category": "Path Navigator"
      },
      {
        "command": "pathNavigator.selectNext",
        "title": "Select Next Result",
        "category": "Path Navigator"
      },
      {
        "command": "pathNavigator.selectPrevious",
        "title": "Select Previous Result",
        "category": "Path Navigator"
      },
      {
        "command": "pathNavigator.goToParent",
        "title": "Go to Parent Directory",
        "category": "Path Navigator"
      },
      {
        "command": "pathNavigator.refreshPicker",
        "title": "Refresh Active Picker",
        "category": "Path Navigator"
      },
      {
        "command": "pathNavigator.openSettings",
        "title": "Open Settings",
        "category": "Path Navigator",
        "icon": "$(gear)"
      },
      {
        "command": "pathNavigator.configureKeyboardShortcuts",
        "title": "Configure Keyboard Shortcuts",
        "category": "Path Navigator",
        "icon": "$(keyboard)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pathNavigator.completePath",
          "when": "false"
        },
        {
          "command": "pathNavigator.selectNext",
          "when": "false"
        },
        {
          "command": "pathNavigator.selectPrevious",
          "when": "false"
        },
        {
          "command": "pathNavigator.goToParent",
          "when": "false"
        },
        {
          "command": "pathNavigator.refreshPicker",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pathNavigator.open",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "pathNavigator.completePath",
        "key": "tab",
        "when": "pathNavigator.active"
      },
      {
        "command": "pathNavigator.selectNext",
        "key": "down",
        "when": "pathNavigator.active"
      },
      {
        "command": "pathNavigator.selectPrevious",
        "key": "up",
        "when": "pathNavigator.active"
      },
      {
        "command": "pathNavigator.goToParent",
        "key": "shift+tab",
        "when": "pathNavigator.active"
      },
      {
        "command": "pathNavigator.refreshPicker",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "pathNavigator.active"
      }
    ],
    "configuration": {
      "title": "Path Navigator",
      "properties": {
        "pathNavigator.maxResults": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 2000,
          "description": "Maximum number of matching files and directories shown in the picker."
        },
        "pathNavigator.showFiles": {
          "type": "boolean",
          "default": true,
          "description": "Show file results in the picker."
        },
        "pathNavigator.showDirectories": {
          "type": "boolean",
          "default": true,
          "description": "Show directory results in the picker. Disable this for a file-only quick opener."
        },
        "pathNavigator.fuzzyMatching": {
          "type": "boolean",
          "default": true,
          "description": "Allow non-contiguous fuzzy matches after exact, prefix, and substring matches."
        },
        "pathNavigator.directoryAction": {
          "type": "string",
          "enum": [
            "reveal",
            "enter"
          ],
          "enumDescriptions": [
            "Pressing Enter reveals the directory in Explorer.",
            "Pressing Enter enters the directory and continues searching inside it."
          ],
          "default": "reveal",
          "description": "Action performed when Enter accepts a directory result. Tab always enters the directory."
        },
        "pathNavigator.resultPathDisplay": {
          "type": "string",
          "enum": [
            "parent",
            "full",
            "hidden"
          ],
          "enumDescriptions": [
            "Show only the containing directory beside each result.",
            "Show the complete workspace-relative path.",
            "Hide path descriptions. Multi-root workspaces still show the workspace name."
          ],
          "default": "parent",
          "description": "Controls how paths are displayed beside result names."
        },
        "pathNavigator.freezeResultsOnNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Freeze the visible result snapshot before keyboard or mouse navigation so background updates cannot move the selection."
        },
        "pathNavigator.keepOpenOnFocusLost": {
          "type": "boolean",
          "default": false,
          "description": "Keep the Path Navigator picker open when focus moves to another part of VS Code."
        },
        "pathNavigator.showStatusPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Show indexing, searching, paused, and result-limit information above the candidate list."
        },
        "pathNavigator.maxIndexEntries": {
          "type": "number",
          "default": 500000,
          "minimum": 0,
          "maximum": 2000000,
          "description": "Maximum number of workspace paths retained in the index. Set to 0 for no limit. The picker reports when this limit is reached."
        },
        "pathNavigator.indexConcurrency": {
          "type": "number",
          "default": 12,
          "minimum": 1,
          "maximum": 32,
          "description": "Maximum number of workspace directories read concurrently while indexing. Lower this for high-latency or resource-constrained remote workspaces."
        },
        "pathNavigator.autoRefreshIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rebuild the path index after files or directories are created or deleted."
        },
        "pathNavigator.maxSearchCandidates": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 100000,
          "description": "Maximum number of indexed paths scored by an expanded fuzzy search. One- and two-character searches use lower internal limits."
        },
        "pathNavigator.searchTimeBudgetMs": {
          "type": "number",
          "default": 150,
          "minimum": 25,
          "maximum": 2000,
          "description": "Soft time budget in milliseconds for an expanded fuzzy search. Exact, prefix, and recent-path candidates are considered first."
        },
        "pathNavigator.recentPathsLimit": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 1000,
          "description": "Maximum number of recently and frequently opened workspace paths retained locally for ranking. Set to 0 to disable history."
        },
        "pathNavigator.excludeDirectoryNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".git",
            "node_modules",
            ".next",
            ".turbo",
            ".venv",
            "venv",
            ".cache",
            ".pytest_cache",
            ".mypy_cache",
            ".ruff_cache",
            "__pycache__",
            "coverage",
            "dist",
            "out",
            "build",
            "target"
          ],
          "description": "Directory names that are excluded from the path index."
        },
        "pathNavigator.excludeFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "File extensions or suffixes excluded from the index, for example [\".log\", \"map\", \".test.ts\"]."
        },
        "pathNavigator.openFilesInPreview": {
          "type": "boolean",
          "default": false,
          "description": "Open selected files as preview editors instead of pinned tabs."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test test/*.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.0"
  }
}
